generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  leader
  member
  observer
}

enum TopicJobStatus {
  pending
  processing
  completed
  failed
}

enum BrainstormPhase {
  ideation
  sharing
  clustering
  voting
  confirmed
}

enum TeamType {
  HACKATHON
  CAPSTONE
  BOOTCAMP
  SIDE_PROJECT
  STARTUP
}

enum ProjectDuration {
  UNDER_1_DAY
  ONE_TO_FOUR_WEEKS
  ONE_TO_THREE_MONTHS
  OVER_THREE_MONTHS
}

enum CompletionTarget {
  DEMO
  MVP
  PRODUCTION
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  emailVerified   DateTime?
  image           String?
  role            String?
  accounts        Account[]
  sessions        Session[]
  memberships     TeamMembership[]
  surveyResponses SurveyResponse[]
  brainstormIdeas BrainstormIdea[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id                String             @id @default(uuid())
  name              String
  inviteCode        String             @unique
  description       String?
  memberships       TeamMembership[]
  surveyResponses   SurveyResponse[]
  kickoffTopicJob   KickoffTopicJob?
  kickoffTopics     KickoffTopic[]
  kickoffReactions  KickoffReaction[]
  brainstormSession BrainstormSession?
  createdAt         DateTime           @default(now())
  // ── Team Context (KF-036~KF-040) ──
  teamType          TeamType?
  projectDuration   ProjectDuration?
  completionTarget  CompletionTarget?
  hasNonDeveloper   Boolean?
  usesVibeCoding    Boolean?
  hasSkillGap       Boolean?
  domainHints       String[]           @default([])
  updatedAt         DateTime           @updatedAt
}

model TeamMembership {
  id            String    @id @default(uuid())
  teamId        String
  userId        String
  role          TeamRole
  confirmedRole String? // '프론트엔드' | '백엔드' | '풀스택' | 'PM/기획' | 'AI/데이터' | 'DevOps' | 'QA/테스트' | '디자인' | '기타'
  confirmedAt   DateTime?
  confirmedBy   String? // 팀장 userId (FK 없음 — soft ref)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model SurveyResponse {
  id               String    @id @default(uuid())
  teamId           String
  userId           String
  answers          Json // SurveyAnswersSchema로 검증 후 저장
  metadata         Json? // SurveyMetadataSchema (draftStep, autosavedAt 등)
  submitted        Boolean   @default(false)
  submittedAt      DateTime?
  roleReaction     String?
  roleReactionNote String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId, submitted])
}

model KickoffTopicJob {
  id        String         @id @default(cuid())
  teamId    String         @unique
  status    TopicJobStatus @default(pending)
  errorMsg  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  topics    KickoffTopic[]
}

model KickoffTopic {
  id            String            @id @default(cuid())
  teamId        String
  jobId         String
  title         String
  rationale     String
  tags          String[]
  sourceIdeaIds String[]
  aiGenerated   Boolean           @default(true)
  confirmedAt   DateTime?
  createdAt     DateTime          @default(now())
  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  job           KickoffTopicJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reactions     KickoffReaction[]
}

model KickoffReaction {
  id        String       @id @default(cuid())
  topicId   String
  teamId    String
  userId    String
  reaction  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  topic     KickoffTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
}

model BrainstormSession {
  id               String           @id @default(cuid())
  teamId           String           @unique
  phase            BrainstormPhase  @default(ideation)
  facilitationMode String           @default("async")
  startedAt        DateTime?
  endAt            DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ideas            BrainstormIdea[]
}

model BrainstormIdea {
  id              String            @id @default(cuid())
  sessionId       String
  userId          String
  title           String
  description     String
  type            String            @default("original")
  createdAt       DateTime          @default(now())
  session         BrainstormSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id])
  reactions       IdeaReaction[]
  buildOnAsParent IdeaBuildOnEdge[] @relation("parentIdea")
  buildOnAsChild  IdeaBuildOnEdge[] @relation("childIdea")

  @@index([sessionId, userId])
}

model IdeaBuildOnEdge {
  id           String         @id @default(cuid())
  parentIdeaId String
  childIdeaId  String
  createdBy    String
  createdAt    DateTime       @default(now())
  parentIdea   BrainstormIdea @relation("parentIdea", fields: [parentIdeaId], references: [id], onDelete: Cascade)
  childIdea    BrainstormIdea @relation("childIdea", fields: [childIdeaId], references: [id], onDelete: Cascade)

  @@unique([parentIdeaId, childIdeaId])
}

model IdeaReaction {
  id        String         @id @default(cuid())
  ideaId    String
  userId    String
  type      String
  content   String?
  createdAt DateTime       @default(now())
  idea      BrainstormIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId, type])
}
