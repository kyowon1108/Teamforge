generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  name       String
  avatarUrl  String?   @map("avatar_url")
  githubUrl  String?   @map("github_url")
  role       String    @default("member") // global role, not team role
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  authAccounts          AuthAccount[]
  teamMemberships       TeamMember[]
  skillAssessments      SkillAssessment[]
  uploads               Upload[]
  kickoffParticipations KickoffParticipant[]

  @@map("users")
}

model AuthAccount {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    @db.VarChar(20)
  providerId   String    @map("provider_id") @db.VarChar(255)
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_accounts")
}

model Team {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  inviteCode      String    @unique @map("invite_code") @db.VarChar(10)
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz
  expectedSize    Int       @default(4) @map("expected_size")
  status          String    @default("active") // active | archived | deleted
  leaderUserId    String    @map("leader_user_id") @db.Uuid
  selectedStack   Json?     @map("selected_stack")
  sprintConfig    Json?     @map("sprint_config")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  members          TeamMember[]
  skillAssessments SkillAssessment[]
  uploads          Upload[]
  aiRunLogs        AiRunLog[]
  meetings         Meeting[]
  kickoffSessions  KickoffSession[]
  integrations     Integration[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member") // leader | member | observer
  status    String   @default("active") // active | left | suspended
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("team_members")
}

model SkillAssessment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  answers        Json?
  skillVector    Unsupported("vector(6)")? @map("skill_vector")
  experienceScore Float?   @map("experience_score")
  reliabilityScore Float?  @map("reliability_score")
  resumeData     Json?     @map("resume_data")
  githubData     Json?     @map("github_data")
  status         String    @default("draft") // draft | submitted | completed
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@map("skill_assessments")
}

model Upload {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  teamId      String?   @map("team_id") @db.Uuid
  uploadType  String    @map("upload_type") @db.VarChar(20) // resume | audio | document
  storagePath String    @map("storage_path") @db.VarChar(500)
  mimeType    String?   @map("mime_type") @db.VarChar(100)
  sizeBytes   Int?      @map("size_bytes")
  parsed      Boolean   @default(false)
  deleteAt    DateTime? @map("delete_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id])
  team Team? @relation(fields: [teamId], references: [id])

  @@index([teamId, userId])
  @@map("uploads")
}

model Meeting {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String    @map("team_id") @db.Uuid
  title         String?   @db.VarChar(200)
  inputType     String    @default("text") @map("input_type") @db.VarChar(20) // text | audio | import
  rawContent    String?   @map("raw_content") @db.Text
  summary       String?   @db.Text
  nextAgenda    Json?     @map("next_agenda")
  analysisStatus String   @default("pending") @map("analysis_status") // pending | analyzing | done | failed
  createdBy     String    @map("created_by") @db.Uuid
  meetingDate   DateTime  @map("meeting_date") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actionItems ActionItem[]

  @@index([teamId, meetingDate])
  @@map("meetings")
}

model ActionItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId   String    @map("meeting_id") @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  description String    @db.Text
  assigneeName String?  @map("assignee_name") @db.VarChar(100)
  assigneeId  String?   @map("assignee_id") @db.Uuid
  dueDate     DateTime? @map("due_date") @db.Date
  status      String    @default("open") // open | done
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@map("action_items")
}

model EventLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String?  @map("team_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  event     String   @db.VarChar(50) // login_success, team_created, survey_submitted, etc.
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([event, createdAt])
  @@index([teamId, event])
  @@map("event_logs")
}

model KickoffSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String    @unique @map("team_id") @db.Uuid
  phase         String    @default("topic_decision") // topic_decision | architecture | summary | completed
  topicDecided  Boolean   @default(false) @map("topic_decided")
  topicTitle    String?   @map("topic_title") @db.VarChar(200)
  topicDescription String? @map("topic_description") @db.Text
  platformType  String?   @map("platform_type") @db.VarChar(50) // web | mobile | desktop | embedded | etc
  features      Json?     // string[] of key features
  complexity    String?   @db.VarChar(20) // simple | moderate | complex
  architecture  Json?     // { framework, styling, realtime, api, server, db, auth, state }
  mermaidDiagram String?  @map("mermaid_diagram") @db.Text
  summaryConfirmed Boolean @default(false) @map("summary_confirmed")
  // Batch A: 의사결정 입력
  outOfScope      Json?   @map("out_of_scope")   // string[] — 이번에 안 하는 것
  successCriteria Json?   @map("success_criteria") // string[3] — 데모 때 반드시 보여줄 것
  collabRules     Json?   @map("collab_rules")   // CollabRules — 협업 규칙 4개
  // 낙관적 동시성 제어
  revision        Int     @default(0)            // 변경마다 +1, 동시 수정 감지용
  // Batch C: AI 산출물 생성 상태
  generationStatus          String    @default("idle") @map("generation_status") // idle | generating | done | failed
  generationRequestedAt     DateTime? @map("generation_requested_at") @db.Timestamptz
  generationCompletedAt     DateTime? @map("generation_completed_at") @db.Timestamptz
  startedBy     String    @map("started_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  team         Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages     KickoffMessage[]
  participants KickoffParticipant[]
  artifacts    KickoffArtifact[]

  @@map("kickoff_sessions")
}

// Batch B: 팀원별 역할 수락 + 우려 + 서명 상태
model KickoffParticipant {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String    @map("session_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  concerns            Json?     // MemberConcern[] — 우려 목록
  roleAcceptanceStatus String   @default("pending") @map("role_acceptance_status") // pending | accepted | adjustment_requested | declined
  alternativeRole     String?   @map("alternative_role") @db.VarChar(100)
  signedAt            DateTime? @map("signed_at") @db.Timestamptz
  signedRevision      Int?      @map("signed_revision") // 서명 시점의 session.revision
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  session KickoffSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@map("kickoff_participants")
}

// Batch C: AI 생성 산출물 (첫 Issue 세트, 첫 회의 Agenda, Mini ADR)
model KickoffArtifact {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  artifactType String    @map("artifact_type") @db.VarChar(30) // first_issues | first_agenda | mini_adrs
  content      Json      // ArtifactContent — 타입별 구조는 Zod 스키마 참조
  sessionRevision Int    @map("session_revision") // 생성 시점의 session.revision
  status       String    @default("draft") // draft | confirmed
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  session KickoffSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, artifactType])
  @@map("kickoff_artifacts")
}

model KickoffMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  role        String   @db.VarChar(20) // user | assistant | system
  content     String   @db.Text
  mermaidCode String?  @map("mermaid_code") @db.Text // extracted mermaid from AI response
  phase       String   @db.VarChar(30) // topic_brainstorm | architecture
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  session KickoffSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("kickoff_messages")
}

// 팀 협업 도구 연동 설정 (Screen 9)
model Integration {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  tool        String    @db.VarChar(30)  // slack | github | discord | notion | linear | jira
  status      String    @default("disconnected") @db.VarChar(20) // connected | disconnected | error
  // Slack/GitHub/Notion OAuth
  accessToken String?   @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz
  // Discord / others (webhook or api key)
  webhookUrl  String?   @map("webhook_url") @db.Text
  // Extra metadata (channel name, repo name, workspace name, etc.)
  meta        Json?
  connectedBy String?   @map("connected_by") @db.Uuid  // userId of leader who connected
  connectedAt DateTime? @map("connected_at") @db.Timestamptz
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, tool])
  @@index([teamId])
  @@map("integrations")
}

model AiRunLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId       String?  @map("team_id") @db.Uuid
  agentId      Int      @map("agent_id") @db.SmallInt
  model        String   @db.VarChar(50)
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 6)
  durationMs   Int?     @map("duration_ms")
  success      Boolean?
  errorCode    String?  @map("error_code") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  team Team? @relation(fields: [teamId], references: [id])

  @@index([teamId, createdAt])
  @@map("ai_run_logs")
}
