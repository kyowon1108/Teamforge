# ─── Auth (NextAuth v5) ───
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── OAuth Providers ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ─── API ───
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamforge

# ─── Server-to-server shared secret (web → api session-exchange) ───
SESSION_EXCHANGE_SECRET=

# ─── WebSocket token secret (API → client WS auth) ───
WS_TOKEN_SECRET=

# ─── Redis (optional in dev, required in production) ───
# 설정하지 않으면 인메모리 폴백 사용 (JtiCache, Socket.io adapter)
REDIS_URL=

# ─── AI APIs ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Integrations (optional) ───
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ─── Production-only settings ───
# NODE_ENV=production
# NEXTAUTH_URL=https://your-domain.com
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# CORS_ORIGIN=https://your-domain.com
