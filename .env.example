# Auth (NextAuth v5 — AUTH_SECRET is the v5 key, NEXTAUTH_SECRET kept for compatibility)
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (fill in when available)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Server-to-server shared secret (web → api session-exchange)
SESSION_EXCHANGE_SECRET=

# AI APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Integrations
